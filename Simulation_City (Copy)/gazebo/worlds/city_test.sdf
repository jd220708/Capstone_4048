<?xml version="1.0"?>

<sdf version="1.9">
  <world name="city_test">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <atmosphere type="adiabatic"/>

    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>5000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.65 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_collision">
      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
        </collision>

      </link>
    </model>

    <model name="new_york_map">

      <pose>-1007.5 -199 0 0 0 0</pose>

      <static>true</static>

      <link name="map_link">

        <visual name="map_visual">

          <geometry>
            <mesh>
              <uri>file:///home/jack/Documents/Simulation_City/export/scene.gltf</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </visual>

      </link>

    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>488</elevation>
    </spherical_coordinates>

  </world>
</sdf>